#!/usr/bin/env bash
# USAGE: sway-unlock [swaylock_pid]
# DESCRIPTION: Unlock a sway session by asking swaylock to unlock and exit (default: all of your swaylocks).

# ==============================================================================
# ARGUMENTS
# ==============================================================================
swaylock_pid=""
while [[ $# -ge 1 ]]; do
	arg="$1" && shift
	case "$arg" in
		--help) sed -n '2,3p' "$0"; exit 0;;
		-*) echo "ERROR: unknown argument: $arg" 1>&2; exit 1;;
		*) swaylock_pid="$arg";;
	esac
done


# ==============================================================================
# MAIN
# ==============================================================================
# Never kill swaylock: sway then stays locked on a solid red screen. SIGUSR1 is its "unlock and exit" signal.
if [[ -n "$swaylock_pid" ]]; then
	if ! kill -s USR1 "$swaylock_pid"; then
		echo "ERROR: cannot signal swaylock pid $swaylock_pid; check it with: ps -p $swaylock_pid" 1>&2
		exit 1
	fi
	exit 0
fi

if ! pkill -USR1 -u "$USER" -x swaylock; then
	echo "ERROR: no swaylock running for $USER" 1>&2
	exit 1
fi

