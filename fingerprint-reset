#!/usr/bin/env bash
# USAGE: sudo fingerprint-reset
# DESCRIPTION: Reset the Synaptics fingerprint reader (06cb:00f9) without a cold shutdown.

# ==============================================================================
# ENVIRONMENT
# ==============================================================================
vendor_id="06cb"
product_id="00f9"

if ((EUID != 0)); then
	echo "ERROR: run as root: sudo fingerprint-reset" 1>&2
	exit 1
fi


# ==============================================================================
# FIND READER
# ==============================================================================
device_dir=""
for candidate_dir in /sys/bus/usb/devices/*; do
	[[ -f "$candidate_dir/idVendor" ]] || continue
	[[ "$(cat "$candidate_dir/idVendor")" == "$vendor_id" ]] || continue
	[[ "$(cat "$candidate_dir/idProduct")" == "$product_id" ]] || continue
	device_dir="$candidate_dir"
	break
done
if [[ -z "$device_dir" ]]; then
	echo "ERROR: reader $vendor_id:$product_id not found on the USB bus; check lsusb" 1>&2
	exit 1
fi
echo "found reader at $device_dir"


# ==============================================================================
# RESET READER
# ==============================================================================
bus_num="$(printf '%03d' "$(cat "$device_dir/busnum")")"
device_num="$(printf '%03d' "$(cat "$device_dir/devnum")")"
# usbreset (from usbutils) does a USBDEVFS_RESET ioctl: a soft replug.
if ! usbreset "$bus_num/$device_num"; then
	echo "ERROR: usbreset $bus_num/$device_num failed; power off for ~30s to recover" 1>&2
	exit 1
fi

# Deauthorize/reauthorize forces a full re-enumeration, which clears more than the ioctl alone.
if ! echo 0 > "$device_dir/authorized"; then
	echo "ERROR: cannot deauthorize $device_dir; check that you ran this with sudo" 1>&2
	exit 1
fi
# 1s off and 2s to re-enumerate are guesses that have worked since 2026-08-02, not measured minimums.
sleep 1
if ! echo 1 > "$device_dir/authorized"; then
	echo "ERROR: cannot reauthorize $device_dir; replug or reboot to recover" 1>&2
	exit 1
fi
sleep 2
echo "re-enumerated $(basename "$device_dir")"

# fprintd caches the init failure; stopping it makes the next client D-Bus-activate a fresh probe.
if ! systemctl stop fprintd; then
	echo "WARNING: cannot stop fprintd; if fingerprint-check still says STUCK, run: sudo systemctl restart fprintd" 1>&2
fi
echo "verify as your user, not root: fingerprint-check"

