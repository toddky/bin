#!/usr/bin/env bash
# USAGE: fingerprint-check
# DESCRIPTION: Report whether the fingerprint reader is usable (exit 0) or stuck (exit 1).

# ==============================================================================
# ARGUMENTS
# ==============================================================================
while [[ $# -ge 1 ]]; do
	arg="$1" && shift
	case "$arg" in
		--help) sed -n '2,3p' "$0"; exit 0;;
		*) echo "ERROR: unknown argument: $arg" 1>&2; exit 1;;
	esac
done


# ==============================================================================
# MAIN
# ==============================================================================
if ! output="$(fprintd-list "$USER" 2>&1)"; then
	cat <<EOF
STUCK: $output

Fix with: sudo ~/bin/fingerprint-reset
If that doesn't help, power off for ~30s (a reboot is not enough).
EOF
	exit 1
fi
echo "OK: $output"

