#!/usr/bin/env bash
# USAGE: ,volume <up|down|mute|mic>
# DESCRIPTION: Change the volume through pactl (amixer as a fallback) and play a tick on up/down

volume_command=volume-amixer
if command -v pactl >/dev/null; then
	volume_command=volume-pactl
fi
"$volume_command" "$1" || exit
if [[ "$1" == up || "$1" == down ]]; then
	play-sound-volume-change
fi
# volume-pactl shows its own popup; the one below is only for the amixer fallback.
if [[ "$volume_command" == volume-pactl ]]; then
	exit
fi

notify_args=()
notify_args+=(-t 400)
notify_args+=(-u normal)
notify_args+=(-h string:x-canonical-private-synchronous:volume)
notify-send "${notify_args[@]}" "$(,volume-info)"
