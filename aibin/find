#!/usr/bin/env bash
# USAGE: find [find-args ...]
# DESCRIPTION: find wrapper that kills a search after 15 seconds and prints narrower alternatives.

# Resolve the real binary through realbin next to this script so this does not recurse into aibin/find.
real_find="$("$(dirname "$(realpath "${BASH_SOURCE[0]}")")/realbin" find)" || exit 1

timeout 15 "$real_find" "$@"
exit_code=$?

if ((exit_code == 124)); then
    cat 1>&2 <<EOF
ERROR: find timed out after 15 seconds. Try one of these instead:

  Limit depth:     find <path> -maxdepth 3 -name <pattern>
  Prune .git:      find <path> -name .git -prune -o -name <pattern> -print
  Narrower path:   find /more/specific/path -name <pattern>
  Inside a repo:   git ls-files --full-name ':/' | grep -i <pattern>
EOF
fi

exit "$exit_code"
