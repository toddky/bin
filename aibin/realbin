#!/usr/bin/env bash
# USAGE: realbin <command>
# DESCRIPTION: Print the first <command> on PATH that is not an aibin wrapper, so a wrapper can exec the real one.

# ==============================================================================
# ARGUMENTS
# ==============================================================================
if (($# != 1)); then
    echo "USAGE: realbin <command>" 1>&2
    exit 1
fi
command_name="$1"

# realbin starts through env and bash; an aibin wrapper for either would call realbin again forever.
# The marker dies with this process because realbin only prints a path and exits.
if [[ -n "${_AIBIN_REALBIN_ACTIVE:-}" ]]; then
    echo "ERROR: realbin called itself while resolving '$command_name'; an aibin wrapper for a command realbin" \
        "uses (env, bash) must find its real binary without realbin." 1>&2
    exit 1
fi
export _AIBIN_REALBIN_ACTIVE=1


# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Parameter expansion instead of dirname and realpath because every wrapped grep pays for each fork (~5ms here).
aibin_dir="${BASH_SOURCE[0]%/*}"
[[ "$aibin_dir" == "${BASH_SOURCE[0]}" ]] && aibin_dir=.


# ==============================================================================
# MAIN
# ==============================================================================
IFS=':' read -r -a path_dirs <<< "$PATH"
for path_dir in "${path_dirs[@]}"; do
    # An empty PATH entry means the current directory.
    [[ -z "$path_dir" ]] && path_dir=.
    candidate_file="${path_dir}/${command_name}"
    [[ -f "$candidate_file" && -x "$candidate_file" ]] || continue
    # Any PATH dir holding a realbin is a copy of aibin, so wrappers from a second copy on PATH are skipped too.
    [[ -e "${path_dir}/realbin" ]] && continue
    printf '%s\n' "$candidate_file"
    exit 0
done

echo "ERROR: no $command_name found on PATH outside $aibin_dir; install it or add its directory to PATH." 1>&2
exit 1

