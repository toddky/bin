#!/usr/bin/env bash
# USAGE: curl [curl-args ...]
# DESCRIPTION: Hide curl args from ps -ef

# ==============================================================================
# RE-EXEC
# ==============================================================================
# re-exec with hidden args
if [[ -z "${_AIBIN_CURL_REEXEC:-}" || $# -gt 0 ]]; then
    export _AIBIN_CURL_REEXEC=1
    # \037 (unit separator) joins the args; it never appears in a shell argv.
    # Guarded because printf repeats its format once even with zero args, which would invent one empty arg.
    _AIBIN_CURL_ARGV=""
    (( $# > 0 )) && _AIBIN_CURL_ARGV="$(printf '%s\037' "$@")"
    export _AIBIN_CURL_ARGV
    exec "$0"
fi


# ==============================================================================
# RUN
# ==============================================================================
reexec_args=()
while IFS= read -r -d $'\037' part; do
    reexec_args+=("$part")
done < <(printf '%s' "$_AIBIN_CURL_ARGV")
set -- "${reexec_args[@]}"
unset _AIBIN_CURL_ARGV _AIBIN_CURL_REEXEC


# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Absolute path avoids a recursive call when aibin/ is in $PATH.
# AIBIN_CURL_REAL overrides the real binary for testing only.
real_curl="${AIBIN_CURL_REAL:-/usr/bin/curl}"


# ==============================================================================
# HELPERS
# ==============================================================================
# Read option arity from the installed curl so the table always matches the binary we exec.
# Help lines look like " -H, --header <header/@file> Pass custom header(s) to server".
declare -A short_to_long=()
declare -A long_takes_value=()
help_regex='^ +(-(.), )?--([^ ]+)( <)?'
while IFS= read -r line; do
    [[ "$line" =~ $help_regex ]] || continue
    long_name="${BASH_REMATCH[3]}"
    long_takes_value["$long_name"]=0
    [[ -n "${BASH_REMATCH[4]}" ]] && long_takes_value["$long_name"]=1
    [[ -n "${BASH_REMATCH[2]}" ]] && short_to_long["${BASH_REMATCH[2]}"]="$long_name"
done < <("$real_curl" --help all 2>/dev/null)
# --header must parse as value-taking; otherwise the help format changed and values would be misread as URLs.
if [[ "${long_takes_value[header]:-}" != 1 ]]; then
    echo "ERROR: curl wrapper could not read the option list from '$real_curl --help all'." \
        "Check that $real_curl exists and that its help lines still look like ' -H, --header <header>'." 1>&2
    exit 1
fi

# Escape a value for a curl config double-quoted string. curl honors the
# backslash escapes \\ \" \t \n \r inside "..." and a literal newline ends the
# value, so fold backslash, quote, and control chars to their escape sequences.
function config_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
}

# Route one parsed option. -q/--disable only works as curl's first argv entry, so it stays on
# argv; everything else, including a nested --config, goes to the config.
function place_option() {
    local long_name="$1"
    if [[ "$long_name" == disable ]]; then
        leading_args+=(--disable)
        return
    fi
    if (( $# == 1 )); then
        config_lines+=("$long_name")
        return
    fi
    config_lines+=("${long_name} = \"$(config_escape "$2")\"")
}

# ==============================================================================
# PARSE ARGS
# ==============================================================================
config_lines=()
leading_args=()
argv_args=()

while (( $# >= 1 )); do
    arg="$1" && shift

    # Anything curl would not parse as an option stays on argv so curl reports it.
    if [[ "$arg" == - || "$arg" == -- ]]; then
        argv_args+=("$arg")
        continue
    fi

    if [[ "$arg" != -* ]]; then
        config_lines+=("url = \"$(config_escape "$arg")\"")
        continue
    fi

    if [[ "$arg" == --* ]]; then
        long_name="${arg#--}"
        takes_value="${long_takes_value[$long_name]:-}"
        # --no-X negates boolean X; most negated spellings are not listed by --help all.
        base_name="${long_name#no-}"
        if [[ -z "$takes_value" && "$long_name" == no-?* && "${long_takes_value[$base_name]:-}" == 0 ]]; then
            takes_value=0
        fi
        if [[ -z "$takes_value" ]] || [[ "$takes_value" == 1 && $# -eq 0 ]]; then
            argv_args+=("$arg")
            continue
        fi
        if [[ "$takes_value" == 0 ]]; then
            place_option "$long_name"
            continue
        fi
        place_option "$long_name" "$1"
        shift
        continue
    fi

    # Short cluster like -sSL or -HFoo: an unknown letter leaves the whole cluster to curl.
    cluster="${arg#-}"
    cluster_known=1
    for (( index = 0; index < ${#cluster}; index++ )); do
        long_name="${short_to_long[${cluster:index:1}]:-}"
        if [[ -z "$long_name" ]]; then
            cluster_known=0
            break
        fi
        [[ "${long_takes_value[$long_name]}" == 1 ]] && break
    done
    if (( cluster_known == 0 )); then
        argv_args+=("$arg")
        continue
    fi

    for (( index = 0; index < ${#cluster}; index++ )); do
        long_name="${short_to_long[${cluster:index:1}]}"
        if [[ "${long_takes_value[$long_name]}" == 0 ]]; then
            place_option "$long_name"
            continue
        fi
        inline_value="${cluster:index+1}"
        if [[ -n "$inline_value" ]]; then
            place_option "$long_name" "$inline_value"
        elif (( $# == 0 )); then
            argv_args+=("-${cluster:index:1}")
        else
            place_option "$long_name" "$1"
            shift
        fi
        break
    done
done


# ==============================================================================
# MAIN
# ==============================================================================
if (( ${#config_lines[@]} == 0 )); then
    exec "$real_curl" "${leading_args[@]}" "${argv_args[@]}"
fi

config_file="$(mktemp --tmpdir curl-cfg.XXXXXX)"
if (( $? != 0 )); then
    echo "ERROR: curl wrapper could not create a temp config file via mktemp." 1>&2
    exit 1
fi
chmod 600 "$config_file"
printf '%s\n' "${config_lines[@]}" > "$config_file"

# Open the config on a fd, then unlink so the cleartext secret does not linger
# on disk while curl runs. curl reads it via /dev/fd/N; the fd survives exec.
exec {config_fd}<"$config_file"
rm -f "$config_file"

exec "$real_curl" "${leading_args[@]}" --config "/dev/fd/${config_fd}" "${argv_args[@]}"

