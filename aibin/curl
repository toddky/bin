#!/usr/bin/env bash
# USAGE: curl [curl-args ...]
# DESCRIPTION: Hide curl args from ps -ef

# ==============================================================================
# RE-EXEC
# ==============================================================================
# re-exec with hidden args
if [[ -z "${_AIBIN_CURL_REEXEC:-}" || $# -gt 0 ]]; then
    export _AIBIN_CURL_REEXEC=1
    # \037 (unit separator) joins the args; it never appears in a shell argv.
    # Guarded because printf repeats its format once even with zero args, which would invent one empty arg.
    _AIBIN_CURL_ARGV=""
    (($# > 0)) && _AIBIN_CURL_ARGV="$(printf '%s\037' "$@")"
    export _AIBIN_CURL_ARGV
    exec "$0"
fi


# ==============================================================================
# RUN
# ==============================================================================
reexec_args=()
while IFS= read -r -d $'\037' part; do
    reexec_args+=("$part")
done < <(printf '%s' "$_AIBIN_CURL_ARGV")
set -- "${reexec_args[@]}"
unset _AIBIN_CURL_ARGV _AIBIN_CURL_REEXEC


# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Absolute path avoids a recursive call when aibin/ is in $PATH.
# AIBIN_CURL_REAL overrides the real binary for testing only.
real_curl="${AIBIN_CURL_REAL:-/usr/bin/curl}"


# ==============================================================================
# HELPERS
# ==============================================================================
# curl's config file accepts the same tokens as argv (-sSL, -H "x", --no-silent), so each arg
# is copied through as-is. The one thing argv has that a config line lacks is "the value is the
# next arg", so read which options take a value from this curl's own help text. Lines look like
# " -H, --header <header/@file> Pass custom header(s) to server".
declare -A takes_value=()
help_regex='^ +(-., )?--([^ ]+)( <)?'
while IFS= read -r line; do
    [[ "$line" =~ $help_regex ]] || continue
    arity=0
    [[ -n "${BASH_REMATCH[3]}" ]] && arity=1
    takes_value["--${BASH_REMATCH[2]}"]=$arity
    [[ -n "${BASH_REMATCH[1]}" ]] && takes_value["${BASH_REMATCH[1]%, }"]=$arity
done < <("$real_curl" --help all 2>/dev/null)
# --header must parse as value-taking; otherwise the help format changed and values would be misread as URLs.
if [[ "${takes_value[--header]:-}" != 1 ]]; then
    echo "ERROR: curl wrapper could not read the option list from '$real_curl --help all'." \
        "Check that $real_curl exists and that its help lines still look like ' -H, --header <header>'." 1>&2
    exit 1
fi

# Escape a value for a curl config double-quoted string. curl honors the
# backslash escapes \\ \" \t \n \r inside "..." and a literal newline ends the
# value, so fold backslash, quote, and control chars to their escape sequences.
function config_escape() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//$'\t'/\\t}"
    value="${value//$'\r'/\\r}"
    value="${value//$'\n'/\\n}"
    printf '%s' "$value"
}


# ==============================================================================
# PARSE ARGS
# ==============================================================================
# Every arg becomes one config line. An option that takes its value from the next arg gets
# that value appended on the same line. Options this curl does not list stay on argv because
# curl only warns about bad config lines but errors on bad argv.
config_lines=()
argv_args=()
leading_args=()

# curl only honors -q as its first argv entry, so keep it there; anywhere else it is a no-op.
if [[ "${1:-}" == -q || "${1:-}" == --disable ]]; then
    leading_args=(-q)
    shift
fi

while (($# >= 1)); do
    arg="$1" && shift

    if [[ "$arg" != -?* ]]; then
        config_lines+=("--url \"$(config_escape "$arg")\"")
        continue
    fi

    # Find the table key that decides arity: the long name (--no-X negates X and is not
    # listed itself), or the first letter of a short cluster that takes a value.
    inline_value=""
    if [[ "$arg" == --* ]]; then
        key="$arg"
        [[ -z "${takes_value[$key]:-}" && "$key" == --no-?* ]] && key="--${key#--no-}"
    else
        for (( index = 1; index < ${#arg}; index++ )); do
            key="-${arg:index:1}"
            [[ "${takes_value[$key]:-x}" != 0 ]] && break
        done
        inline_value="${arg:index+1}"
    fi

    if [[ -z "${takes_value[$key]:-}" ]]; then
        argv_args+=("$arg")
        continue
    fi
    if [[ "${takes_value[$key]}" == 0 || -n "$inline_value" ]]; then
        config_lines+=("$arg")
        continue
    fi
    # Value-taking option with no value left: leave it to curl so it errors instead of warning.
    if (($# == 0)); then
        argv_args+=("$arg")
        continue
    fi
    config_lines+=("$arg \"$(config_escape "$1")\"")
    shift
done


# ==============================================================================
# MAIN
# ==============================================================================
if ((${#config_lines[@]} == 0)); then
    exec "$real_curl" "${leading_args[@]}" "${argv_args[@]}"
fi

if ! config_file="$(mktemp --tmpdir curl-cfg.XXXXXX)"; then
    echo "ERROR: curl wrapper could not create a temp config file via mktemp." 1>&2
    exit 1
fi
chmod 600 "$config_file"
printf '%s\n' "${config_lines[@]}" > "$config_file"

# Open the config on a fd, then unlink so the cleartext secret does not linger
# on disk while curl runs. curl reads it via /dev/fd/N; the fd survives exec.
exec {config_fd}<"$config_file"
rm -f "$config_file"

exec "$real_curl" "${leading_args[@]}" --config "/dev/fd/${config_fd}" "${argv_args[@]}"
