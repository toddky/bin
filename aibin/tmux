#!/usr/bin/env bash
# USAGE: tmux [tmux-args ...]
# DESCRIPTION: tmux wrapper that blocks kill-server so an agent cannot tear down all sessions.

# ==============================================================================
# ARGUMENTS
# ==============================================================================
for argument in "$@"; do
    if [[ "$argument" == "kill-server" ]]; then
        echo "ERROR: tmux kill-server is blocked; use 'tmux kill-session -t <name>' on a socket you created with -L or -S." 1>&2
        exit 1
    fi
done


# ==============================================================================
# ENVIRONMENT
# ==============================================================================
# Resolve the real binary through realbin next to this script so exec does not recurse into aibin/tmux.
real_tmux_file="$("$(dirname "$(realpath "${BASH_SOURCE[0]}")")/realbin" tmux)" || exit 1


# ==============================================================================
# MAIN
# ==============================================================================
exec "$real_tmux_file" "$@"

