#!/usr/bin/env bash
# USAGE: pkill [pkill-args ...]
# DESCRIPTION: pkill wrapper that refuses every call because it matches by name and can hit processes the agent did not start.

cat 1>&2 <<'EOF'
ERROR: pkill is blocked; it kills every process matching the pattern, including ones you did not start.
Find the specific processes, then kill only those PIDs:

  List matches:    pgrep -u "$USER" -af <pattern>
  Kill one:        kill <pid>
  Kill a job:      kill %1   or   kill "$!"   for a process you started in the background
EOF
exit 1
