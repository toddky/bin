#!/usr/bin/env bash

# ==============================================================================
# ARGUMENTS
# ==============================================================================
while [[ $# -ge 1 ]]; do
	arg="$1" && shift
	case "$arg" in
		--title) title="$1" && shift;;
		*) echo "ERROR: unknown argument: $arg; the only option is --title <TITLE>" 1>&2; exit 1;;
	esac
done


# ==============================================================================
# GHOSTTY
# ==============================================================================
if command -v ghostty &> /dev/null; then
	term_cmd=(ghostty)
	[[ -n "$title" ]] && term_cmd+=(--title="$title")
	exec "${term_cmd[@]}"
fi


# ==============================================================================
# ALACRITTY
# ==============================================================================
if command -v alacritty &> /dev/null; then
	term_cmd=(alacritty)
	[[ -n "$title" ]] && term_cmd+=(--title "$title")
	exec "${term_cmd[@]}"
fi


# ==============================================================================
# GNOME-TERMINAL
# ==============================================================================
if command -v gnome-terminal &> /dev/null; then
	# Fixes this error:
	# Error creating terminal: Failed to get screen from object path /org/gnome/Terminal/screen/...
	export GNOME_TERMINAL_SCREEN=''

	term_cmd=(gnome-terminal)
	term_cmd+=(--hide-menubar)
	[[ -n "$title" ]] && term_cmd+=(--title="$title")
	exec "${term_cmd[@]}"
fi

message='ERROR: i3-term found no terminal; install ghostty, alacritty, or gnome-terminal'
echo "$message" 1>&2

nagbar=i3-nagbar
if [[ -n "$WAYLAND_DISPLAY" ]]; then
	nagbar=swaynag
fi
"$nagbar" -m "$message"
exit 2

