#!/usr/bin/env bash
# brightnessctl works on both X11 and Wayland, and on any /sys/class/backlight
# device (the old xbacklight path only worked on intel_backlight, which doesn't
# exist on the Radeon 860M panel).
if ! (type brightnessctl >/dev/null 2>&1); then
	notify-send -u critical 'brightnessctl command not found. Run `sudo apt install brightnessctl`'
	exit 2
fi

# Increase/decrease brightness
brightness_change=""
if [[ "$1" == "up" ]]; then
	brightness_change="+10%"
elif [[ "$1" == "down" ]]; then
	brightness_change="10%-"
fi
# Can't modify brightness: Permission denied
# Writing the backlight needs the video group, so say how to join it instead of showing an unchanged level.
if [[ -n "$brightness_change" ]] && ! output="$(brightnessctl -q set "$brightness_change" 2>&1)"; then
	first_line="$(head -1 <<< "$output")"
	notify-send -u critical "Brightness not changed" "$first_line. Run \`sudo usermod -aG video \$USER\` and log in again."
	exit 1
fi

# Current brightness as a percentage
cur="$(brightnessctl get)"
max="$(brightnessctl max)"
if [[ -z "$cur" || -z "$max" || "$max" == 0 ]]; then
	notify-send -u critical "brightnessctl: no backlight device found"
	exit 2
fi
brightness=$(( 100 * cur / max ))

# If the screen turns completely off, set brightness to 1%
if (( brightness == 0 )); then
	brightnessctl -q set 1%
	brightness=1
fi

# Display brightness notification
brightness_icon="🔆"
bar_color="#6090b0"
dunstify \
	--timeout=1000 \
	--replace=2593 \
	--urgency=normal \
	"$brightness_icon $brightness%" \
	--hints="int:value:$brightness" \
	--hints="string:hlcolor:$bar_color"
