#!/usr/bin/env bash
if [[ -n "$WAYLAND_DISPLAY" ]]; then
	# No click-to-select on Wayland; shows the focused window instead.
	info="$(swaymsg -t get_tree \
		| jq '.. | select(.focused? == true)
			| {name, app_id, window_properties, shell, type, marks}')"
else
	#info="$(xprop | sed -n 's/WM_CLASS.*, *//p')"
	info="$(xprop | grep WM)"
fi

tempfile="$(mktemp)"
function finish {
	rm -rf "$tempfile"
}
trap finish EXIT

echo "$info" > "$tempfile"
xless "$tempfile" & sleep 1
