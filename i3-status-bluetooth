#!/usr/bin/env bash
# USAGE: i3-status-bluetooth
# DESCRIPTION: i3blocks bluetooth block showing power state and connected devices

powered=$(bluetoothctl show 2>/dev/null | grep -c "Powered: yes")

if [[ "$powered" -eq 0 ]]; then
    echo "🔵 off"
    exit 0
fi

# `bluetoothctl devices Connected` is unreliable on bluez 5.72 - it returns
# nearby BLE scan results instead of actually-connected devices. Check
# connection status against the (small, stable) paired-devices list instead.
names=""
while read -r _ mac name; do
    [[ -z "$mac" ]] && continue
    if bluetoothctl info "$mac" 2>/dev/null | grep -q "Connected: yes"; then
        names+="${names:+, }$name"
    fi
done <<< "$(bluetoothctl devices Paired 2>/dev/null)"

if [[ -n "$names" ]]; then
    echo "🔵 $names"
else
    echo "🔵"
fi
