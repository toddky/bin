#!/usr/bin/env bash
# USAGE: sway-lock
# DESCRIPTION: Lock a sway session with swaylock; a fingerprint match unlocks it via sway-unlock.


# ==============================================================================
# ENVIRONMENT
# ==============================================================================
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
log_file="$HOME/sway_lock_debug.log"
background_file="${XDG_CONFIG_HOME:-$HOME/.config}/i3/background.png"


# ==============================================================================
# HELPERS
# ==============================================================================
function log() {
	echo "$(date '+%F %T') $*" >> "$log_file"
}

log "started by $(ps -o comm= -p "$PPID")"

# Sway allows one lock at a time, so a second swaylock fails and its cleanup would undo the first one's.
if pgrep -u "$USER" -x swaylock > /dev/null; then
	log "swaylock already running, nothing to do"
	exit 0
fi


# ==============================================================================
# PAUSE NOTIFICATIONS
# ==============================================================================
,media pause
# https://wiki.archlinux.org/title/Dunst#Disable_dunst_temporarily
killall -SIGUSR1 dunst


# ==============================================================================
# LOCK SCREEN
# ==============================================================================
# --daemonize returns once the screen is locked, so swayidle -w before-sleep can let the suspend go ahead.
swaylock_args=()
swaylock_args+=(--daemonize)
swaylock_args+=(--show-failed-attempts)
swaylock_args+=(--ignore-empty-password)
swaylock_args+=(--color=101030)
if [[ -f "$background_file" ]]; then
	swaylock_args+=(--image="$background_file")
	swaylock_args+=(--tiling)
fi
if ! swaylock "${swaylock_args[@]}"; then
	log "ERROR: swaylock failed to lock; run swaylock by hand to see why"
	killall -SIGUSR2 dunst
	exit 1
fi
swaylock_pid="$(pgrep -n -u "$USER" -x swaylock)"
if [[ -z "$swaylock_pid" ]]; then
	log "ERROR: swaylock locked but its pid was not found; fingerprint unlock is off for this lock"
	exit 1
fi


# ==============================================================================
# FINGERPRINT UNLOCK
# ==============================================================================
"$script_dir/fingerprint-unlock" "$swaylock_pid" "$script_dir/sway-unlock" "$swaylock_pid" >> "$log_file" 2>&1 &


# ==============================================================================
# WAIT FOR UNLOCK
# ==============================================================================
# Runs in the background so sway-lock exits as soon as the screen is locked.
(
	tail --pid="$swaylock_pid" -f /dev/null
	log "swaylock exited"
	# https://wiki.archlinux.org/title/Dunst#Disable_dunst_temporarily
	killall -SIGUSR2 dunst
) &

