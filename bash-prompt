# ==============================================================================
# PERFORMANCE
# ==============================================================================
# - /bin/bash, not `env bash`: env would search PATH
# - `read` for the parent process name, not `cat`: no fork
# - $USER, not `whoami`: no fork
# - `date` for the timer only when a command was timed: no fork otherwise
# - `printf -v` and `printf '%(%T)T'`, not `$(printf ...)` and `$(date +%T)`: no subshell or fork
# - One `stat -c '%a %U %g'`, not three `stat` calls
# - ${PWD##*/}, not `basename`: no fork
# - [[ . -ef "$PWD" ]], not `readlink -f .` and [[ -d "$PWD" ]]: no fork
# - [[ "$PWD" == *"$username"* ]], not `grep`: no fork
# - Walk up for .git in bash, not `git rev-parse` and `git safe-top`: no git at all outside a repo
# - One `git status --porcelain=v2 --branch`, not six git calls: it reports branch, upstream, ahead/behind and dirty


# Reset LD_LIBRARY_PATH
export LD_LIBRARY_PATH=/lib64:/usr/lib64

read -r parent 2>/dev/null < "/proc/$PPID/comm"
username="${USER:-$(id -un)}"

if [[ "$parent" == bash ]]; then
	reset="\[\e[0m\]"
	red='\[\e[1;31m\]'
	green='\[\e[1;32m\]'
	yellow='\[\e[1;93m\]'
	blue='\[\e[1;34m\]'
	magenta='\[\e[1;35m\]'
	cyan='\[\e[1;36m\]'
	white='\[\e[1;37m\]'

	red_bg='\[\e[41m\]'
	green_bg='\[\e[42m\]'
	yellow_bg='\[\e[43m\]'
	blue_bg='\[\e[44m\]'
	magenta_bg='\[\e[45m\]'
	cyan_bg='\[\e[46m\]'
	white_bg='\[\e[47m\]'
else
	reset="\e[0m"
	red='\e[1;31m'
	green='\e[1;32m'
	yellow='\e[1;93m'
	blue='\e[1;34m'
	magenta='\e[1;35m'
	cyan='\e[1;36m'
	white='\e[1;37m'

	red_bg='\e[41m'
	green_bg='\e[42m'
	yellow_bg='\e[43m'
	blue_bg='\e[44m'
	magenta_bg='\e[45m'
	cyan_bg='\e[46m'
	white_bg='\e[47m'
fi

# Print failing exit code of last command
((RETVAL)) && printf "\e[31m(exited $RETVAL)\e[0m\n"

# Get execution time
#start_ms="$1"
if ((start_ms)); then
	current_ms="$(date +'%s%3N')"

	# Get seconds
	total_ms=$((current_ms - start_ms))
	ms=$((total_ms % 1000))
	total_s=$((total_ms / 1000))
	printf -v time_str "%d.%03ds" "$total_s" "$ms"

	# Get hours
	if (( total_s >= 3600 )); then
		num_hours=$((total_s / 3600))
		printf -v hours_str " (%d.%02d hours)" "$num_hours" "$(((total_s % 3600) * 100 / 3600))"
		time_str+="$hours_str"
	fi
	printf "\x1b[38;5;8m[%(%T)T] Finished in %s \e[0m\n" -1 "$time_str"

	# Notify if command took over 60s and pane is not focused
	if [[ -n "$TMUX_PANE" ]] && (( total_s >= 60 )); then
		is_focused="$(tmux display-message -t "$TMUX_PANE" -p '#{pane_active}#{window_active}')"
		[[ "$is_focused" != "11" ]] && tmux-notify &
	fi
fi

# Prompt
prompt=''


# ==============================================================================
# USERNAME
# ==============================================================================
#prompt+="$blue\u"
prompt+="${blue}todd"


# ==============================================================================
# HOST
# ==============================================================================
if [[ ! -e ${TMUX%%,*} ]]; then
	[[ -n $LSB_BATCH_JID ]] && lsf=1 || lsf=0
	[[ $lsf == 1 ]] && prompt+=":$yellow$LSB_BATCH_JID$blue" || prompt+="@\h"
fi
if [[ -n "$SINGULARITY_CONTAINER" ]]; then
	prompt+="$yellow <singularity>$blue"
fi


# ==============================================================================
# DIRECTORY
# ==============================================================================
#dir=${PWD%/*/*}
#dir2=${PWD#$dir/}

# Directory permissions
[[ "$OSTYPE" =~ .*darwin.* ]] && ismac=1 || ismac=0
stat_args=()
if ((ismac)); then
	stat_args+=(-f '%Lp %Su %g')
else
	stat_args+=(-c '%a %U %g')
fi
stat_output="$(stat "${stat_args[@]}" . 2>/dev/null)"
read -r permission owner dir_gid <<<"$stat_output"

if [[ -n "$permission" ]]; then
	p1="${permission:(-3):1}"
	p2="${permission:(-2):1}"
	p3="${permission:(-1):1}"

	prompt+=" "
	[[ "$username" == "$owner" ]] && prompt+="$green$p1" || prompt+="$red$p1"
	# $GROUPS is the bash builtin GID list. Avoids forking groups(1), which
	# blocks on SSSD group lookups here (~5s per prompt).
	[[ " ${GROUPS[*]} " == *" $dir_gid "* ]] && prompt+="$green$p2" || prompt+="$red$p2"
	prompt+="$green$p3"
fi

base="${PWD##*/}"
[[ -z "$base" ]] && base=/
# -ef catches a deleted or replaced cwd (e.g. after rm -rf build && mkdir build).
if ! [[ . -ef "$PWD" ]]; then
	base_color="$red"
elif [[ "$PWD" == *"$username"* ]]; then
	base_color="$green"
else
	base_color="$yellow"
fi
prompt+=" $base_color$base"


# ==============================================================================
# GIT
# ==============================================================================
# Appends the git part of the prompt to $prompt.
# Example: clean branch main, 2 ahead of upstream -> appends "<green> main <yellow>+2"
function append_git_prompt() {
	local search_dir="$PWD" git_top='' git_output git_exit line
	local branch='' ahead_behind='' has_upstream=0 is_dirty=0 num_ahead=0 num_behind=0 branch_color

	# Same walk as git-safe-top, but -e so worktrees and submodules (.git is a file) count too.
	while [[ -n "$search_dir" ]]; do
		if [[ -e "$search_dir/.git" ]]; then
			git_top="$search_dir"
			break
		fi
		search_dir="${search_dir%/*}"
	done
	[[ -z "$git_top" && -z "${GIT_DIR:-}" ]] && return

	# GIT_OPTIONAL_LOCKS=0 stops status from taking index.lock, which can race a git command in another pane.
	git_output="$(GIT_OPTIONAL_LOCKS=0 git status --porcelain=v2 --branch --untracked-files=no --ignore-submodules=all 2>&1)"
	git_exit=$?
	if ((git_exit)); then
		if [[ "$git_output" == *"must be run in a work tree"* ]]; then
			prompt+="$red .git"
		else
			prompt+=" ${red}<unsafe>"
		fi
		return
	fi

	[[ -f "$git_top/.git/index.lock" ]] && prompt+=" ${red}<locked>"

	while IFS= read -r line; do
		case "$line" in
			'# branch.head '*) branch="${line#'# branch.head '}";;
			# Only present when the upstream exists, which matches the old `git rev-parse @{u}` check.
			'# branch.ab '*) has_upstream=1; ahead_behind="${line#'# branch.ab '}";;
			'1 '*|'2 '*|'u '*) is_dirty=1;;
		esac
	done <<<"$git_output"

	[[ "$branch" == '(detached)' ]] && branch=HEAD
	if [[ -n "$ahead_behind" ]]; then
		num_ahead="${ahead_behind%% *}"
		num_ahead="${num_ahead#+}"
		num_behind="${ahead_behind##* -}"
	fi

	if ((!has_upstream)); then
		branch_color="$cyan"
	elif ((is_dirty)); then
		branch_color="$red"
	else
		branch_color="$green"
	fi
	prompt+="$branch_color $branch"
	((num_ahead)) && prompt+=" $yellow+$num_ahead"
	((num_behind)) && prompt+=" $red-$num_behind"
}
append_git_prompt


