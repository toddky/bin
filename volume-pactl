#!/usr/bin/env bash
if ! (type pactl >/dev/null); then
	notify-send -t 2000 -u critical 'pactl command not found. Run `sudo apt install pulseaudio`'
	exit 2
fi

sink="@DEFAULT_SINK@"
#sink="0"

cmd="$1"
case "$cmd" in
	up)
		pactl -- set-sink-volume "$sink" +5%
		pactl set-sink-mute "$sink" false
		;;
	down)
		pactl -- set-sink-volume "$sink" -5%
		pactl set-sink-mute "$sink" false
		;;
	mute)
		pactl set-sink-mute "$sink" toggle;;
	mic)
		amixer sset Capture toggle;;
	*)
		notify-send -t 2000 -u critical ",volume-pactl command '$cmd' not found"
		exit 2
		;;
esac

# ==============================================================================
# NOTIFY
# ==============================================================================
# Volume: front-left: 22931 /  35% / -27.36 dB,   front-right: 22931 /  35% / -27.36 dB
volume_percent="$(pactl get-sink-volume "$sink" | grep -o -m 1 '[0-9]*%' | head -1)"
volume_percent="${volume_percent%\%}"

# Mute: yes
muted=0
if pactl get-sink-mute "$sink" | grep -q "Mute: yes"; then
	muted=1
fi

if ((muted)); then
	title="🔇 Muted"
elif ((volume_percent < 34)); then
	title="🔈 Volume ${volume_percent}%"
elif ((volume_percent < 67)); then
	title="🔉 Volume ${volume_percent}%"
else
	title="🔊 Volume ${volume_percent}%"
fi

# [{"name": "bluez_output.98_47_44_79_62_10.1", "description": "Soundcore Space A40", ...}]
sink_name="$(pactl get-default-sink)"
device_name="$(pactl -f json list sinks | jq -r --arg name "$sink_name" '.[] | select(.name == $name) | .description')"

notify_args=()
notify_args+=(-t 400)
notify_args+=(-u normal)
notify_args+=(-h string:x-canonical-private-synchronous:volume)
# dunst draws int:value as a progress bar; pactl allows volume past 100%, which the bar shows as full.
notify_args+=(-h "int:value:$volume_percent")
notify-send "${notify_args[@]}" "$title" "$device_name"

